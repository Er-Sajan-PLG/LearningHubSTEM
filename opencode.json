{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": true,
      "environment": { "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PAT}" }
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp@latest"],
      "enabled": true
    }
  },
  "skills": {
    "paths": ["./skills"]
  },
  "instructions": ["AGENTS.md", "docs/README.md"],
  "agent": {
    "build": {
      "description": "Primary coding agent for this STEM knowledge foundation repo",
      "mode": "primary",
      "model": "singularity-beta/deepseek-ai/DeepSeek-V4-Flash-0731",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true,
        "read": true,
        "changed-files": true,
        "grep": true,
        "glob": true,
        "list": true,
        "mcp__github": true,
        "mcp__context7": true
      }
    },
    "python-reviewer": {
      "description": "Review Python code (validation scripts, governance)",
      "mode": "subagent",
      "model": "bluesmind/deepseek-v4-pro"
    }
  }
}